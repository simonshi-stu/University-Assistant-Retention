# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# All project tasks use the Flash model.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_TYPE=enabled

# Client behavior
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=3

# Local project defaults
PROJECT_ENV=local
PYTHONUTF8=1

# Historical analysis clock and ordered data windows
ANALYSIS_REFERENCE_DATE=2024-01-01
PRIMARY_DATA_YEARS=2021,2022,2023
FALLBACK_DATA_YEARS=2022,2023,2024
LAST_RESORT_DATA_YEARS=2023,2024,2025
DATA_WINDOW_MODE=primary

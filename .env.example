# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Provider API model ID. Keep this separate from the workflow's human-facing
# executor role name because provider model IDs can change.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_TYPE=disabled

# Client behavior
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=0

# Auditable three-role development workflow
WORKFLOW_SUPERVISOR_MODEL=gpt-5.6-sol
WORKFLOW_REVIEWER_MODEL=gpt-5.6-luna
WORKFLOW_EXECUTOR_MODEL=deepseek-v4.1-flash
WORKFLOW_DEEPSEEK_CALLS_PER_TASK=1
WORKFLOW_REQUIRE_TESTS=true
WORKFLOW_REQUIRE_DIFF_REVIEW=true

# Local project defaults
PROJECT_ENV=local
PYTHONUTF8=1

# Historical analysis clock and ordered data windows
ANALYSIS_REFERENCE_DATE=2024-01-01
PRIMARY_DATA_YEARS=2021,2022,2023
FALLBACK_DATA_YEARS=2022,2023,2024
LAST_RESORT_DATA_YEARS=2023,2024,2025
DATA_WINDOW_MODE=primary
